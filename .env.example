# App
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=dev-only-secret-key-change-me-32-bytes
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host ports (chosen to avoid common local conflicts)
HTTP_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# Database
POSTGRES_PASSWORD=incidentpilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# RabbitMQ
RABBITMQ_PASSWORD=incidentpilot
RABBITMQ_EXCHANGE=incidentpilot
RABBITMQ_INVESTIGATION_QUEUE=incidentpilot.investigation
RABBITMQ_DLQ=incidentpilot.dlq

# Auth
WEBHOOK_TOKEN=dev-webhook-token
INTERNAL_TOKEN=dev-internal-token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@incidentpilot.io
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123456!
BOOTSTRAP_SRE_EMAIL=sre@incidentpilot.io
BOOTSTRAP_SRE_PASSWORD=ChangeMe123456!
BOOTSTRAP_VIEWER_EMAIL=viewer@incidentpilot.io
BOOTSTRAP_VIEWER_PASSWORD=ChangeMe123456!

# LLM (NVIDIA NIM, OpenAI-compatible)
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
LLM_TEMPERATURE=0.1
LLM_STRIP_REASONING=true

# Feature flags
DEMO_MODE=false
AGENT_ENABLED=false
REMEDIATION_ENABLED=false
AUTO_APPROVE_LOW_RISK=false
